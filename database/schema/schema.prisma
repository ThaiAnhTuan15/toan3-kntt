// schema.prisma
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -----------------------------------------------------------------------------
// USER MANAGEMENT
// -----------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  ADMIN
  TEACHER
  PARENT
  STUDENT
}

model User {
  id        String   @id @default(uuid())
  email     String?  @unique
  phone     String?  @unique
  password  String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isActive  Boolean  @default(true)

  studentProfile Student?
  parentProfile  Parent?
  teacherProfile Teacher?
  auditLogs      AuditLog[]
}

model School {
  id        String    @id @default(uuid())
  name      String
  code      String?   @unique
  classes   Class[]
  teachers  Teacher[]
  students  Student[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Class {
  id        String    @id @default(uuid())
  name      String
  grade     Int
  schoolId  String
  school    School    @relation(fields: [schoolId], references: [id])
  teacherId String?
  teacher   Teacher?  @relation(fields: [teacherId], references: [id])
  students  Student[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Teacher {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  schoolId  String?
  school    School?  @relation(fields: [schoolId], references: [id])
  classes   Class[]
  firstName String
  lastName  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Parent {
  id        String    @id @default(uuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id])
  firstName String
  lastName  String
  children  Student[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Student {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  parentId  String?
  parent    Parent?  @relation(fields: [parentId], references: [id])
  schoolId  String?
  school    School?  @relation(fields: [schoolId], references: [id])
  classId   String?
  class     Class?   @relation(fields: [classId], references: [id])
  firstName String
  lastName  String
  dob       DateTime?
  
  attempts        Attempt[]
  learningSessions LearningSession[]
  studentProgress StudentProgress?
  skillProgress   SkillProgress[]
  lessonProgress  LessonProgress[]
  topicProgress   TopicProgress[]
  reviewQueue     ReviewQueue[]
  studentBadges   StudentBadge[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// ACADEMIC TIMELINE
// -----------------------------------------------------------------------------

model AcademicYear {
  id        String     @id @default(uuid())
  name      String     // e.g. "2023-2024"
  startDate DateTime
  endDate   DateTime
  semesters Semester[]
}

model Semester {
  id             String       @id @default(uuid())
  name           String       // e.g. "Học kỳ 1"
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  startDate      DateTime
  endDate        DateTime
  months         Month[]
}

model Month {
  id         String   @id @default(uuid())
  name       String   // e.g. "Tháng 9"
  semesterId String
  semester   Semester @relation(fields: [semesterId], references: [id])
  weeks      Week[]
}

model Week {
  id         String   @id @default(uuid())
  name       String   // e.g. "Tuần 1"
  monthId    String
  month      Month    @relation(fields: [monthId], references: [id])
  weekNumber Int
}

// -----------------------------------------------------------------------------
// CURRICULUM & BOOK MAPPING
// -----------------------------------------------------------------------------

model Curriculum {
  id           String                  @id @default(uuid())
  name         String                  // e.g. "GDPT 2018 - Toán 3"
  requirements CurriculumRequirement[]
}

model CurriculumRequirement {
  id           String      @id @default(uuid())
  code         String      // e.g. "YC-03"
  description  String
  curriculumId String
  curriculum   Curriculum  @relation(fields: [curriculumId], references: [id])
  skills       Skill[]
  questions    Question[]
}

model Book {
  id        String        @id @default(uuid())
  title     String        // e.g. "Toán 3 Kết nối tri thức với cuộc sống"
  publisher String
  chapters  BookChapter[]
}

model BookChapter {
  id      String       @id @default(uuid())
  title   String
  bookId  String
  book    Book         @relation(fields: [bookId], references: [id])
  lessons BookLesson[]
}

model BookLesson {
  id          String      @id @default(uuid())
  title       String
  lessonOrder Int
  chapterId   String
  chapter     BookChapter @relation(fields: [chapterId], references: [id])
  skills      Skill[]
  questions   Question[]
  progress    LessonProgress[]
}

model Topic {
  id        String      @id @default(uuid())
  name      String
  subtopics Subtopic[]
  progress  TopicProgress[]
}

model Subtopic {
  id      String  @id @default(uuid())
  name    String
  topicId String
  topic   Topic   @relation(fields: [topicId], references: [id])
  skills  Skill[]
}

model Skill {
  id          String                 @id @default(uuid())
  name        String
  description String?
  subtopicId  String?
  subtopic    Subtopic?              @relation(fields: [subtopicId], references: [id])
  lessonId    String?
  lesson      BookLesson?            @relation(fields: [lessonId], references: [id])
  requirementId String?
  requirement CurriculumRequirement? @relation(fields: [requirementId], references: [id])
  
  questions   Question[]
  progress    SkillProgress[]
  reviewQueue ReviewQueue[]
}

// -----------------------------------------------------------------------------
// QUESTION ENGINE
// -----------------------------------------------------------------------------

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  FILL_NUMBER
  FILL_ANSWER
  MATCHING
  ORDERING
}

enum QuestionStatus {
  DRAFT
  AI_GENERATED
  NEEDS_REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
  REJECTED
}

model Question {
  id            String         @id @default(uuid())
  code          String         @unique // e.g. "M3-Q-000001"
  stem          String         @db.Text
  type          QuestionType
  difficulty    Int            // 1 to 5
  status        QuestionStatus @default(DRAFT)
  
  skillId       String
  skill         Skill          @relation(fields: [skillId], references: [id])
  lessonId      String?
  lesson        BookLesson?    @relation(fields: [lessonId], references: [id])
  requirementId String?
  requirement   CurriculumRequirement? @relation(fields: [requirementId], references: [id])

  correctAnswer String
  explanation   String?        @db.Text
  hint          String?        @db.Text
  estimatedTime Int            // in seconds
  
  options       QuestionOption[]
  tags          QuestionTag[]
  media         QuestionMedia[]
  versions      QuestionVersion[]
  testQuestions TestQuestion[]
  answers       Answer[]
  
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model QuestionOption {
  id         String   @id @default(uuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id])
  text       String
  isCorrect  Boolean
}

model QuestionTag {
  id         String   @id @default(uuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id])
  tag        String
}

model QuestionMedia {
  id         String   @id @default(uuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id])
  url        String
  type       String   // "IMAGE", "VIDEO"
}

model QuestionVersion {
  id         String   @id @default(uuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id])
  version    Int
  content    Json     // snapshot of question content
  createdAt  DateTime @default(now())
}

// -----------------------------------------------------------------------------
// TESTS
// -----------------------------------------------------------------------------

model Test {
  id          String   @id @default(uuid())
  title       String
  description String?
  type        String   // e.g. "WEEKLY", "MID_TERM"
  duration    Int?     // in minutes
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  questions   TestQuestion[]
  attempts    Attempt[]
  blueprint   TestBlueprint?
}

model TestBlueprint {
  id      String @id @default(uuid())
  testId  String @unique
  test    Test   @relation(fields: [testId], references: [id])
  config  Json   // percentages of levels, topics
}

model TestQuestion {
  id         String   @id @default(uuid())
  testId     String
  test       Test     @relation(fields: [testId], references: [id])
  questionId String
  question   Question @relation(fields: [questionId], references: [id])
  order      Int
}

// -----------------------------------------------------------------------------
// LEARNING ENGINE & PROGRESS
// -----------------------------------------------------------------------------

model LearningSession {
  id           String    @id @default(uuid())
  studentId    String
  student      Student   @relation(fields: [studentId], references: [id])
  startTime    DateTime  @default(now())
  endTime      DateTime?
  accuracy     Float?
  difficultyAvg Float?
  attempts     Attempt[]
}

model Attempt {
  id        String          @id @default(uuid())
  studentId String
  student   Student         @relation(fields: [studentId], references: [id])
  testId    String?
  test      Test?           @relation(fields: [testId], references: [id])
  sessionId String?
  session   LearningSession? @relation(fields: [sessionId], references: [id])
  score     Float?
  startTime DateTime        @default(now())
  endTime   DateTime?
  
  answers   Answer[]
  result    Result?
}

model Answer {
  id           String   @id @default(uuid())
  attemptId    String
  attempt      Attempt  @relation(fields: [attemptId], references: [id])
  questionId   String
  question     Question @relation(fields: [questionId], references: [id])
  studentAnswer String
  isCorrect    Boolean
  timeSpent    Int      // in seconds
  createdAt    DateTime @default(now())
}

model Result {
  id        String   @id @default(uuid())
  attemptId String   @unique
  attempt   Attempt  @relation(fields: [attemptId], references: [id])
  score     Float
  summary   Json     // e.g. { correct: 8, wrong: 2, skills: [...] }
}

model StudentProgress {
  id         String   @id @default(uuid())
  studentId  String   @unique
  student    Student  @relation(fields: [studentId], references: [id])
  overallScore Float  @default(0)
  level      Int      @default(1)
  stars      Int      @default(0)
  coins      Int      @default(0)
  streakData Json?
  badges     Json?
  wrongQuestions Json?
  gameState  Json?
  updatedAt  DateTime @updatedAt
}

enum MasteryLevel {
  WEAK
  DEVELOPING
  PROFICIENT
  MASTERED
}

model SkillProgress {
  id           String       @id @default(uuid())
  studentId    String
  student      Student      @relation(fields: [studentId], references: [id])
  skillId      String
  skill        Skill        @relation(fields: [skillId], references: [id])
  accuracy     Float        @default(0)
  attemptCount Int          @default(0)
  recentAccuracy Float      @default(0)
  level        MasteryLevel @default(WEAK)
  updatedAt    DateTime     @updatedAt

  @@unique([studentId, skillId])
}

model LessonProgress {
  id         String     @id @default(uuid())
  studentId  String
  student    Student    @relation(fields: [studentId], references: [id])
  lessonId   String
  lesson     BookLesson @relation(fields: [lessonId], references: [id])
  completion Float      @default(0) // percentage
  updatedAt  DateTime   @updatedAt

  @@unique([studentId, lessonId])
}

model TopicProgress {
  id         String   @id @default(uuid())
  studentId  String
  student    Student  @relation(fields: [studentId], references: [id])
  topicId    String
  topic      Topic    @relation(fields: [topicId], references: [id])
  completion Float    @default(0)
  updatedAt  DateTime @updatedAt

  @@unique([studentId, topicId])
}

model ReviewQueue {
  id             String   @id @default(uuid())
  studentId      String
  student        Student  @relation(fields: [studentId], references: [id])
  skillId        String
  skill          Skill    @relation(fields: [skillId], references: [id])
  nextReviewDate DateTime
  interval       Int      // e.g. in days
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([studentId, skillId])
}

// -----------------------------------------------------------------------------
// GAMIFICATION
// -----------------------------------------------------------------------------

model Badge {
  id          String   @id @default(uuid())
  name        String
  description String
  imageUrl    String?
  students    StudentBadge[]
}

model Achievement {
  id          String   @id @default(uuid())
  name        String
  description String
}

model StudentBadge {
  id        String   @id @default(uuid())
  studentId String
  student   Student  @relation(fields: [studentId], references: [id])
  badgeId   String
  badge     Badge    @relation(fields: [badgeId], references: [id])
  earnedAt  DateTime @default(now())

  @@unique([studentId, badgeId])
}

// -----------------------------------------------------------------------------
// SYSTEM
// -----------------------------------------------------------------------------

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  details   Json
  createdAt DateTime @default(now())
}

model SystemSetting {
  id    String @id @default(uuid())
  key   String @unique
  value String
}
