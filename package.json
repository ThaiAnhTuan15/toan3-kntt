{
  "name": "toan3-kntt-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "database"
  ],
  "scripts": {
    "build": "npm run db:generate && npm run build --workspace=api",
    "start": "npm run start --workspace=api",
    "dev:web": "npm run dev --workspace=web",
    "dev:api": "npm run dev --workspace=api",
    "db:generate": "prisma generate --schema=./database/schema/schema.prisma"
  }
}
